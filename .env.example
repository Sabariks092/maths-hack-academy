# Google Apps Script web app URL (Deploy > New deployment > Web app > copy the /exec URL)
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXX/exec

# The admin password is NOT set here. Anything named VITE_* is bundled into the
# public JavaScript. Set it in Apps Script instead:
#   Project Settings > Script properties > ADMIN_PASS
